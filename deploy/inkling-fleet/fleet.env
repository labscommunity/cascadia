# Fleet layout for the Inkling installation. Edit the addresses to match the
# venue's wired network; every box's installer reads this file from the SSD.
# Rank r listens on RELAY_PORT+r and dials rank r+1 at IP_(r+1); rank 0 serves
# the OpenAI-compatible API on port 8000 (and the dashboard).
TOTAL=12
RELAY_PORT=9100
IP_0=192.168.50.10
IP_1=192.168.50.11
IP_2=192.168.50.12
IP_3=192.168.50.13
IP_4=192.168.50.14
IP_5=192.168.50.15
IP_6=192.168.50.16
IP_7=192.168.50.17
IP_8=192.168.50.18
IP_9=192.168.50.19
IP_10=192.168.50.20
IP_11=192.168.50.21
# Concurrent streams per rank (identical on every rank) and the context budget.
STREAMS=16
MAX_SEQ=1024
# Fused MoE layers the iGPU takes per box (each is 8.3 GB of unified memory,
# the rest of the rank's layers stay on the CPU at 7.7 GB each; Windows caps
# the iGPU at half of RAM, so 3 on a 64 GB Windows box). 4 on Linux leaves
# ~14 GB for the OS, the stream slots and the IR compile; try 5 once a box
# has been seen running.
FUSED_LAYERS_LINUX=4
FUSED_LAYERS_WINDOWS=3
