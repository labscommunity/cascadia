[Unit]
Description=Cascadia worker (rank %i)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cascadia
Group=cascadia

# Adjust to where you've installed cascadia + checked out / mounted shards.
Environment=CASCADIA_HOME=/opt/cascadia
Environment=CASCADIA_SHARDS=/opt/cascadia/shards/llama-3.1-8b-v5
Environment=CASCADIA_TOTAL=2
Environment=CASCADIA_NEXT=10.0.0.2:9100
Environment=CASCADIA_LISTEN=:9100
Environment=CASCADIA_DEVICE=GPU
Environment=CASCADIA_ENGINE=ov-runtime

# %i is the instance suffix (use `cascadia-worker@0.service`, `@1.service`, ...).
ExecStart=/usr/bin/env cascadia worker \
    --rank %i --total ${CASCADIA_TOTAL} \
    --engine ${CASCADIA_ENGINE} --device ${CASCADIA_DEVICE} \
    --model ${CASCADIA_SHARDS} \
    --listen ${CASCADIA_LISTEN} \
    --next ${CASCADIA_NEXT} \
    --pid-file /run/cascadia/cascadia-worker-%i.pid \
    --log-level INFO

# Cascadia handles SIGTERM cleanly via signal.signal(SIGTERM, _shutdown).
KillSignal=SIGTERM
TimeoutStopSec=30

# Restart on crash, but back off so we don't churn on a config error.
Restart=on-failure
RestartSec=5
StartLimitIntervalSec=60
StartLimitBurst=3

# Resource isolation. Uncomment / tighten for production.
# LimitNOFILE=65535
# MemoryHigh=24G
# MemoryMax=28G

[Install]
WantedBy=multi-user.target
