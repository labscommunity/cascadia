[Unit]
Description=Tahoma worker (rank %i)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tahoma
Group=tahoma

# Adjust to where you've installed tahoma + checked out / mounted shards.
Environment=TAHOMA_HOME=/opt/tahoma
Environment=TAHOMA_SHARDS=/opt/tahoma/shards/llama-3.1-8b-v5
Environment=TAHOMA_TOTAL=2
Environment=TAHOMA_NEXT=10.0.0.2:9100
Environment=TAHOMA_LISTEN=:9100
Environment=TAHOMA_DEVICE=GPU
Environment=TAHOMA_ENGINE=ov-runtime

# %i is the instance suffix (use `tahoma-worker@0.service`, `@1.service`, ...).
ExecStart=/usr/bin/env tahoma worker \
    --rank %i --total ${TAHOMA_TOTAL} \
    --engine ${TAHOMA_ENGINE} --device ${TAHOMA_DEVICE} \
    --model ${TAHOMA_SHARDS} \
    --listen ${TAHOMA_LISTEN} \
    --next ${TAHOMA_NEXT} \
    --pid-file /run/tahoma/tahoma-worker-%i.pid \
    --log-level INFO

# Tahoma handles SIGTERM cleanly via signal.signal(SIGTERM, _shutdown).
KillSignal=SIGTERM
TimeoutStopSec=30

# Restart on crash, but back off so we don't churn on a config error.
Restart=on-failure
RestartSec=5
StartLimitIntervalSec=60
StartLimitBurst=3

# Resource isolation. Uncomment / tighten for production.
# LimitNOFILE=65535
# MemoryHigh=24G
# MemoryMax=28G

[Install]
WantedBy=multi-user.target
