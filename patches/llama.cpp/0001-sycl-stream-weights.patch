+// ---- shared stream upload machinery (weight slots + expert arenas) ----
+// dedicated H2D queue per device so copies overlap compute on the in-order
+// main stream; process-lifetime, shared by every pool and expert arena on
+// the device
+static sycl::queue * sycl_stream_copy_queue(int device) {
+    static std::mutex mu;
+    static std::unordered_map<int, sycl::queue *> qs;
+    std::lock_guard<std::mutex> lock(mu);
+    auto it = qs.find(device);
+    if (it != qs.end()) {
+        return it->second;
+    }
+    sycl::queue * q = new sycl::queue(
+        dpct::dev_mgr::instance().get_device(device).create_queue());
+    qs[device] = q;
+    return q;
+}
+
+static int sycl_stream_staging_nbufs(void) {
+    static int v = -1;
+    if (v < 0) {
+        const char * e = getenv("GGML_STREAM_STAGING_BUFS");
+        v = e && atoi(e) > 0 ? atoi(e) : 8;
+        if (v > 64) {
+            v = 64;
+        }
+    }
+    return v;
+}
+
+struct sycl_stream_staging_buf {
+    char *      ptr  = nullptr;
+    size_t      cap  = 0;
+    sycl::event ev;   // last copy command reading this buffer
+    bool        live = false;
+};
+
+// a free staging buffer for n bytes: free means the copy reading it has
+// completed; when the whole ring is in flight the next slot is waited on.
+// caller records the new copy event on the returned slot
+static int sycl_stream_staging_pick(std::vector<sycl_stream_staging_buf> & staging,
+                                    int & next, sycl::queue * cq, size_t n) {
+    const int K = (int) staging.size();
+    int chosen = -1;
+    for (int k = 0; k < K; k++) {
+        const int i = (next + k) % K;
+        auto & b = staging[i];
+        if (!b.live ||
+            b.ev.get_info<sycl::info::event::command_execution_status>() ==
+                sycl::info::event_command_status::complete) {
+            chosen = i;
+            break;
+        }
+    }
+    if (chosen < 0) {
+        chosen = next;
+        staging[chosen].ev.wait();
+    }
+    auto & b = staging[chosen];
+    if (b.cap < n) {
+        if (b.ptr != nullptr) {
+            sycl::free(b.ptr, cq->get_context());
+        }
+        b.ptr = (char *) sycl::malloc_host(n, *cq);
+        if (b.ptr == nullptr) {
+            GGML_LOG_ERROR("%s: failed to allocate %zu bytes pinned staging\n", __func__, n);
+            std::exit(1);
+        }
+        b.cap = n;
+    }
+    b.live = false;
+    next = (chosen + 1) % K;
+    return chosen;
+}
