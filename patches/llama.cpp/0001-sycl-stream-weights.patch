+// ---- disk-backed weight streaming (GGML_STREAM_WEIGHTS) ----
+// Layer weights registered by the loader are not uploaded at model load.
+// They share a fixed slot pool and are re-uploaded just-in-time before the
+// node that consumes them, tracked per-slot so any visit order is correct.
+// The in-order queue serializes uploads vs ops. Fused-op paths are disabled
+// while streaming because their covered nodes are opaque to this scan.
+
+struct sycl_stream_pool {
+    bool built   = false;
+    int  device  = -1;
+    queue_ptr q  = nullptr;
+
+    struct entry {
+        ggml_stream_src src;
+        size_t          nbytes;
+        size_t          padded;
+        size_t          slot_off;
+        int             widx;
+    };
+
+    void *                                         pool = nullptr;
+    size_t                                         pool_bytes = 0;
+    std::vector<size_t>                            slot_off;
+    std::vector<const ggml_tensor *>               slot_owner;
+    std::unordered_map<const ggml_tensor *, entry> map;
+    std::vector<char>                              staging;
+    size_t                                         bytes_uploaded = 0;
+    size_t                                         uploads = 0;
+};
+static std::unordered_map<ggml_backend_buffer_t, sycl_stream_pool> g_swpools;
+
+static size_t sycl_stream_padded_size(const ggml_tensor * t) {
+    size_t size = ggml_nbytes(t);
+    if (ggml_is_quantized(t->type) && t->ne[0] % MATRIX_ROW_PADDING != 0) {
+        size += ggml_row_size(t->type, MATRIX_ROW_PADDING - t->ne[0] % MATRIX_ROW_PADDING);
+    }
+    return size;
+}
+
+static bool ggml_sycl_stream_build(sycl_stream_pool & sw, ggml_backend_buffer_t buf, int device, queue_ptr q) try {
+    int n0 = ggml_stream_snapshot(nullptr, nullptr, 0);
+    if (n0 <= 0) {
+        return false;
+    }
+
+    std::vector<const ggml_tensor *> ts0(n0);
+    std::vector<ggml_stream_src>     recs0(n0);
+    ggml_stream_snapshot(ts0.data(), recs0.data(), n0);
+
+    std::vector<const ggml_tensor *> ts;
+    std::vector<ggml_stream_src>     recs;
+    for (int i = 0; i < n0; i++) {
+        if (ts0[i]->buffer == buf) {
+            ts.push_back(ts0[i]);
+            recs.push_back(recs0[i]);
+        }
+    }
+    const int n = (int) ts.size();
+    if (n == 0) {
+        return false;
+    }
+
+    int nw = 0;
+    for (auto & r : recs) {
+        nw = std::max(nw, r.widx + 1);
+    }
+    std::vector<size_t> wmax(nw, 0);
+    for (int i = 0; i < n; i++) {
+        auto & e   = sw.map[ts[i]];
+        e.src      = recs[i];
+        e.widx     = recs[i].widx;
+        e.nbytes   = ggml_nbytes(ts[i]);
+        e.padded   = sycl_stream_padded_size(ts[i]);
+        wmax[e.widx] = std::max(wmax[e.widx], e.padded);
+    }
+
+    sw.slot_off.assign(nw, 0);
+    size_t off = 0;
+    for (int w = 0; w < nw; w++) {
+        sw.slot_off[w] = off;
+        off += GGML_PAD(wmax[w], SYCL_BUFFER_ALIGNMENT);
+    }
+    sw.pool_bytes = off;
+
+    sw.pool = ggml_sycl_malloc_device(sw.pool_bytes, *q);
+    if (sw.pool == nullptr) {
+        GGML_LOG_ERROR("%s: failed to allocate %zu bytes stream slot pool\n", __func__, sw.pool_bytes);
+        return false;
+    }
+
+    for (int i = 0; i < n; i++) {
+        auto & e = sw.map[ts[i]];
+        e.slot_off = sw.slot_off[recs[i].widx];
+        ggml_tensor * t = const_cast<ggml_tensor *>(ts[i]);
+        t->data = (char *) sw.pool + e.slot_off;
+        if (t->extra) {
+            ((ggml_tensor_extra_gpu *) t->extra)->data_device[device] = t->data;
+        }
+    }
+
+    sw.slot_owner.assign(nw, nullptr);
+    sw.device = device;
+    sw.built  = true;
+    GGML_LOG_INFO("%s: stream slots %.2f MiB (%d slots, %d streamed tensors)\n",
+                  __func__, sw.pool_bytes / 1048576.0, nw, n);
+    return true;
+}
+catch (sycl::exception const &exc) {
+    std::cerr << exc.what() << "Exception caught at file:" << __FILE__
+              << ", line:" << __LINE__ << std::endl;
+    return false;
+}
+
+static void ggml_sycl_stream_upload_one(sycl_stream_pool & sw, const ggml_tensor * t) {
+    auto it = sw.map.find(t);
+    if (it == sw.map.end()) {
+        return;
+    }
+    auto & e = it->second;
+    char * dst = (char *) sw.pool + e.slot_off;
+
+    // L0 cannot USM-memcpy from file-mapped pages - stage through a plain
+    // host buffer first (same workaround as ggml_backend_sycl_buffer_set_tensor)
+    if (sw.staging.size() < e.nbytes) {
+        sw.staging.resize(e.nbytes);
+    }
+    if (e.src.host_ptr != nullptr) {
+        memcpy(sw.staging.data(), e.src.host_ptr, e.nbytes);
+    } else {
+#ifndef _WIN32
+        size_t got = 0;
+        while (got < e.nbytes) {
+            ssize_t r = pread(e.src.fd, sw.staging.data() + got, e.nbytes - got,
+                              (off_t) (e.src.file_off + got));
+            if (r <= 0) {
+                GGML_LOG_ERROR("%s: pread failed for streamed tensor\n", __func__);
+                std::exit(1);
+            }
+            got += (size_t) r;
+        }
+        if (getenv("GGML_STREAM_DEBUG")) {
+            uint64_t h = 1469598103934665603ull;
+            for (size_t b = 0; b < e.nbytes; b += 4096) { h = (h ^ (uint8_t) sw.staging[b]) * 1099511628211ull; }
+            fprintf(stderr, "[sw] %s off=%zu n=%zu fnv=%llx\n", t->name, e.src.file_off, e.nbytes,
+                    (unsigned long long) h);
+        }
+#else
+        GGML_LOG_ERROR("%s: fd-based streaming not supported on Windows\n", __func__);
+        std::exit(1);
+#endif
+    }
+    SYCL_CHECK(CHECK_TRY_ERROR(sw.q->memcpy(dst, sw.staging.data(), e.nbytes).wait()));
+    if (e.padded > e.nbytes) {
+        SYCL_CHECK(CHECK_TRY_ERROR(sw.q->memset(dst + e.nbytes, 0, e.padded - e.nbytes).wait()));
+    }
+    // raw file bytes were uploaded - the in-place reorder optimization must run again
+    if (t->extra) {
+        ((ggml_tensor_extra_gpu *) t->extra)->optimized_feature.reorder = false;
+    }
+    sw.bytes_uploaded += e.nbytes;
+    sw.uploads++;
+}
+
+static void ggml_sycl_stream_node(ggml_backend_sycl_context * sycl_ctx, const ggml_tensor * n) {
+    for (int j = 0; j < GGML_MAX_SRC && n->src[j] != nullptr; j++) {
+        const ggml_tensor * s = n->src[j];
+        while (s->view_src != nullptr) {
+            s = s->view_src;
+        }
+        const ggml_stream_src * rec = ggml_stream_find(s);
+        if (rec == nullptr || s->buffer == nullptr || !ggml_backend_buffer_is_sycl(s->buffer)) {
+            continue;
+        }
+        sycl_stream_pool & sw = g_swpools[s->buffer];
+        if (!sw.built) {
+            auto * bctx = (ggml_backend_sycl_buffer_context *) s->buffer->context;
+            sw.q = bctx->stream;
+            if (!ggml_sycl_stream_build(sw, s->buffer, bctx->device, sw.q)) {
+                continue;
+            }
+        }
+        GGML_UNUSED(sycl_ctx);
+        auto it = sw.map.find(s);
+        if (it == sw.map.end()) {
+            continue;
+        }
+        if (sw.slot_owner[it->second.widx] != s) {
+            ggml_sycl_stream_upload_one(sw, s);
+            sw.slot_owner[it->second.widx] = s;
+        }
+    }
+}
