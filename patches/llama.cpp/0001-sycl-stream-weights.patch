+// strict decimal parse of GGML_STREAM_VRAM_SHARE: the expected co-tenant
+// count in [1, UINT32_MAX]. returns 1 when unset; rejects empty, signed,
+// trailing-text, zero, and overflowing values
+static uint64_t ggml_stream_vram_share() {
+    const char * e = getenv("GGML_STREAM_VRAM_SHARE");
+    if (e == nullptr) {
+        return 1;
+    }
+    bool ok = e[0] != '\0';
+    for (const char * p = e; *p != '\0'; p++) {
+        ok = ok && (*p >= '0' && *p <= '9');
+    }
+    const uint64_t v = ok ? strtoull(e, nullptr, 10) : 0;
+    if (!ok || v < 1 || v > UINT32_MAX) {
+        throw std::runtime_error(
+            std::string("stream-weights: GGML_STREAM_VRAM_SHARE='") + e +
+            "' is not a valid co-tenant count (expected a decimal integer in [1, 4294967295])");
+    }
+    return v;
+}
