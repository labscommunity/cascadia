     GGML_ASSERT((uintptr_t)ptr % TENSOR_ALIGNMENT == 0 && "buffer pointer must be aligned");
     return ggml_backend_buffer_init(ggml_backend_cpu_buffer_from_ptr_type(), ggml_backend_cpu_buffer_from_ptr_i, ptr, size);
 }
+
+// disk-backed weight streaming registry
+
+static int ggml_stream_env_flag(void) {
+    static int v = -1;
+    if (v < 0) {
+        const char * e = getenv("GGML_STREAM_WEIGHTS");
+        v = (e && atoi(e) != 0) ? 1 : 0;
+    }
+    return v;
+}
+
+static size_t ggml_stream_min_bytes(void) {
+    static size_t v = 0;
+    if (v == 0) {
+        const char * e = getenv("GGML_STREAM_MIN_KB");
+        v = e && atoi(e) > 0 ? (size_t) atoi(e) * 1024 : 256 * 1024;
+    }
+    return v;
+}
+
+static int ggml_stream_parse_layer(const char * name) {
+    if (strncmp(name, "blk.", 4) != 0) {
+        return -1;
+    }
+    const char * p = name + 4;
+    if (*p < '0' || *p > '9') {
+        return -1;
+    }
+    char * end = NULL;
+    long l = strtol(p, &end, 10);
+    if (end == NULL || *end != '.') {
+        return -1;
+    }
+    return (int) l;
+}
+
+static int g_stream_resident = 0;
+static bool g_stream_disabled = false;
+
+void ggml_stream_set_resident_layers(int n) {
+    g_stream_resident = n;
+}
+
+void ggml_stream_disable(void) {
+    g_stream_disabled = true;
+}
+
+static int ggml_stream_n_resident(void) {
+    static int env = -2;
+    if (env == -2) {
+        const char * e = getenv("GGML_STREAM_RESIDENT_LAYERS");
+        env = e ? atoi(e) : -1;
+    }
+    return env >= 0 ? env : g_stream_resident;
+}
+
+int ggml_stream_weights_enabled(void) {
+    return ggml_stream_env_flag() && !g_stream_disabled;
+}
+
+static std::unordered_map<const ggml_tensor *, ggml_stream_src> g_stream_map;
+static std::mutex g_stream_mu;
+static std::unordered_set<std::string> g_stream_planned;
+static std::unordered_map<int, int> g_stream_fds;
+
+void ggml_stream_plan(const char * name) {
+    if (name == NULL) {
+        return;
+    }
+    std::lock_guard<std::mutex> lock(g_stream_mu);
+    g_stream_planned.insert(name);
+}
+
+void ggml_stream_plan_reset(void) {
+    std::lock_guard<std::mutex> lock(g_stream_mu);
+    g_stream_planned.clear();
+    // drop the previous model's registrations and close its stream
+    // descriptors: reloads used to leak one dup()d fd per model file and
+    // keep stale tensor keys a recycled address could collide with
+    g_stream_map.clear();
+    for (auto & kv : g_stream_fds) {
+#ifdef _WIN32
+        _close(kv.second);
+#else
+        close(kv.second);
+#endif
+    }
+    g_stream_fds.clear();
+}
+
+static bool ggml_stream_is_planned(const ggml_tensor * tensor) {
+    std::lock_guard<std::mutex> lock(g_stream_mu);
+    return g_stream_planned.count(tensor->name) != 0;
+}
+
+int ggml_stream_dup_fd(int file_fd) {
+    std::lock_guard<std::mutex> lock(g_stream_mu);
+    auto it = g_stream_fds.find(file_fd);
+    if (it != g_stream_fds.end()) {
+        return it->second;
+    }
+#ifdef _WIN32
+    const int fd = _dup(file_fd);
+#else
+    const int fd = dup(file_fd);
+#endif
+    if (fd < 0) {
+        throw std::runtime_error(std::string("stream-weights: dup() of the model file failed: ") + strerror(errno) +
+                                 " (streaming keeps one descriptor per model file; raise the open-file limit)");
+    }
+    g_stream_fds[file_fd] = fd;
+    return fd;
+}
+
+// true if the tensor would stream with no resident layers kept
+bool ggml_stream_is_streamable(const ggml_tensor * tensor) {
+    if (!ggml_stream_weights_enabled() || tensor == NULL) {
+        return false;
+    }
+    return ggml_stream_parse_layer(tensor->name) >= 0 &&
+           ggml_nbytes(tensor) >= ggml_stream_min_bytes();
+}
+
+bool ggml_stream_is_weight(const ggml_tensor * tensor) {
+    return ggml_stream_is_streamable(tensor) &&
+           ggml_stream_parse_layer(tensor->name) >= ggml_stream_n_resident() &&
+           ggml_stream_is_planned(tensor);
+}
+
+void ggml_stream_register(ggml_tensor * tensor, const void * host_ptr, int fd, size_t file_off) {
+    const int layer = ggml_stream_parse_layer(tensor->name);
+    if (layer < 0) {
+        return;
+    }
+    std::lock_guard<std::mutex> lock(g_stream_mu);
+    int widx = 0;
+    for (auto & kv : g_stream_map) {
+        if (kv.second.layer == layer) {
+            widx++;
+        }
+    }
+    g_stream_map[tensor] = { host_ptr, fd, file_off, layer, widx };
+}
+
+const ggml_stream_src * ggml_stream_find(const ggml_tensor * tensor) {
+    std::lock_guard<std::mutex> lock(g_stream_mu);
+    auto it = g_stream_map.find(tensor);
+    return it == g_stream_map.end() ? nullptr : &it->second;
+}
+
+int ggml_stream_snapshot(const ggml_tensor ** tensors, ggml_stream_src * recs, int max_n) {
+    std::lock_guard<std::mutex> lock(g_stream_mu);
+    int n = 0;
+    for (auto & kv : g_stream_map) {
+        if (n < max_n && tensors && recs) {
+            tensors[n] = kv.first;
+            recs[n] = kv.second;
+        }
+        n++;
+    }
+    return n;
+}
