+// ---- shared stream upload machinery (weight slots + expert arenas) ----
+// dedicated H2D queue per device so copies overlap compute on the in-order
+// main stream; process-lifetime, shared by every pool and expert arena on
+// the device
+static sycl::queue * sycl_stream_copy_queue(int device) {
+    static std::mutex mu;
+    static std::unordered_map<int, sycl::queue *> qs;
+    std::lock_guard<std::mutex> lock(mu);
+    auto it = qs.find(device);
+    if (it != qs.end()) {
+        return it->second;
+    }
+    sycl::queue * q = new sycl::queue(
+        dpct::dev_mgr::instance().get_device(device).create_queue());
+    // the async staging pipeline serializes same-slot reuse through this
+    // queue's submission order - out-of-order execution would break it
+    GGML_ASSERT(q->is_in_order());
+    qs[device] = q;
+    return q;
+}
+
+static int sycl_stream_staging_nbufs(void) {
+    static int v = -1;
+    if (v < 0) {
+        const char * e = getenv("GGML_STREAM_STAGING_BUFS");
+        v = e && atoi(e) > 0 ? atoi(e) : 8;
+        if (v > 64) {
+            v = 64;
+        }
+    }
+    return v;
+}
+
+struct sycl_stream_staging_buf {
+    char *      ptr  = nullptr;
+    size_t      cap  = 0;
+    sycl::event ev;   // last copy command reading this buffer
+    bool        live = false;
+};
+
+// a free staging buffer for n bytes: free means the copy reading it has
+// completed; when the whole ring is in flight the next slot is waited on.
+// caller records the new copy event on the returned slot
+static int sycl_stream_staging_pick(std::vector<sycl_stream_staging_buf> & staging,
+                                    int & next, sycl::queue * cq, size_t n) {
+    const int K = (int) staging.size();
+    int chosen = -1;
+    for (int k = 0; k < K; k++) {
+        const int i = (next + k) % K;
+        auto & b = staging[i];
+        if (!b.live ||
+            b.ev.get_info<sycl::info::event::command_execution_status>() ==
+                sycl::info::event_command_status::complete) {
+            chosen = i;
+            break;
+        }
+    }
+    if (chosen < 0) {
+        chosen = next;
+        staging[chosen].ev.wait();
+    }
+    auto & b = staging[chosen];
+    if (b.cap < n) {
+        if (b.ptr != nullptr) {
+            sycl::free(b.ptr, cq->get_context());
+        }
+        b.ptr = (char *) sycl::malloc_host(n, *cq);
+        if (b.ptr == nullptr) {
+            GGML_LOG_ERROR("%s: failed to allocate %zu bytes pinned staging\n", __func__, n);
+            std::exit(1);
+        }
+        b.cap = n;
+    }
+    b.live = false;
+    next = (chosen + 1) % K;
+    return chosen;
+}
+
+// ---- async staging fills: keep file reads off the dispatch thread ----
+// Fully streamed decode was measured read-bound: one serial pread per
+// upload took ~100% of decode wall time even with every page cached.
+// Reader threads fill the pinned staging buffers instead; the in-order
+// copy queue then gates each memcpy on a host task that waits for the
+// fill, so submission order - and with it every slot-ordering argument -
+// is unchanged. GGML_STREAM_READ_THREADS=0 restores the inline read.
+
+// one outstanding fill: dst is the pinned staging buffer, host a
+// file-mapped source when the loader registered one, fd+off a positioned
+// read otherwise; for host sources the byte read starts at
+// host + (off - file_off)
+struct sycl_stream_read_job {
+    std::mutex              mu;
+    std::condition_variable cv;
+    bool         done     = false;
+    char *       dst      = nullptr;
+    const void * host     = nullptr;
+    int          fd       = -1;
+    size_t       file_off = 0;
+    size_t       off      = 0;
+    size_t       n        = 0;
+    const char * name     = nullptr;   // debug only
+    // the weight buffer this fill belongs to: a teardown drains only its
+    // own jobs, not the whole per-device pool
+    ggml_backend_buffer_t owner = nullptr;
+};
+
+struct sycl_stream_readers {
+    std::mutex                                           mu;
+    std::condition_variable                              cv;
+    std::condition_variable                              drained;
+    std::deque<std::shared_ptr<sycl_stream_read_job>>    jobs;
+    std::vector<std::thread>                             th;
+    int                                                  outstanding = 0; // queued + filling
+    std::unordered_map<ggml_backend_buffer_t, int>       outstanding_by_buf;
+    bool                                                 started     = false;
+};
+
+static int sycl_stream_read_threads(void) {
+    static int v = -1;
+    if (v < 0) {
+        const char * e = getenv("GGML_STREAM_READ_THREADS");
+        v = e ? atoi(e) : 4;
+        if (v < 0) {
+            v = 0;
+        }
+        if (v > 16) {
+            v = 16;
+        }
+    }
+    return v;
+}
+
+// process-lifetime reader pools, one per device - same lifetime contract
+// as the copy queues above; never destructed so exit-order is a non-issue
+static sycl_stream_readers * g_readers = nullptr;
+static sycl_stream_readers & sycl_stream_readers_for(int device) {
+    static std::mutex mu;
+    std::lock_guard<std::mutex> lock(mu);
+    if (g_readers == nullptr) {
+        g_readers = new sycl_stream_readers[GGML_SYCL_MAX_DEVICES];
+    }
+    return g_readers[device];
+}
+
+// positioned read of n bytes into host staging (pread / positioned
+// ReadFile) or a plain memcpy from a registered host pointer
+static bool sycl_stream_read_fill(char * dst, const void * host, int fd,
+                                  size_t file_off, size_t off, size_t n) {
+    if (host != nullptr) {
+        memcpy(dst, (const char *) host + (off - file_off), n);
+        return true;
+    }
+    size_t got = 0;
+    while (got < n) {
+#ifdef _WIN32
+        // UCRT has no pread; do a positioned ReadFile on the fd's OS
+        // handle (does not disturb the CRT file position)
+        HANDLE h = (HANDLE) _get_osfhandle(fd);
+        if (h == INVALID_HANDLE_VALUE) {
+            return false;
+        }
+        size_t chunk = n - got;
+        if (chunk > (size_t) 0x7FFFFFFF) {
+            chunk = (size_t) 0x7FFFFFFF;
+        }
+        OVERLAPPED ov;
+        memset(&ov, 0, sizeof(ov));
+        const uint64_t o = (uint64_t) (off + got);
+        ov.Offset     = (DWORD) (o & 0xFFFFFFFFu);
+        ov.OffsetHigh = (DWORD) (o >> 32);
+        DWORD rd = 0;
+        if (!ReadFile(h, dst + got, (DWORD) chunk, &rd, &ov) || rd == 0) {
+            return false;
+        }
+        got += (size_t) rd;
+#else
+        const ssize_t r = pread(fd, dst + got, n - got, (off_t) (off + got));
+        if (r < 0 && errno == EINTR) {
+            continue;
+        }
+        if (r <= 0) {
+            return false;
+        }
+        got += (size_t) r;
+#endif
+    }
+    return true;
+}
+
+static void sycl_stream_debug_fill(const char * name, size_t off, size_t n, const char * buf) {
+    if (!getenv("GGML_STREAM_DEBUG")) {
+        return;
+    }
+    uint64_t h = 1469598103934665603ull;
+    for (size_t b = 0; b < n; b += 4096) { h = (h ^ (uint8_t) buf[b]) * 1099511628211ull; }
+    fprintf(stderr, "[sw] %s off=%zu n=%zu fnv=%llx\n", name, off, n,
+            (unsigned long long) h);
+}
+
+static void sycl_stream_reader_run(sycl_stream_readers * r) {
+    for (;;) {
+        std::shared_ptr<sycl_stream_read_job> job;
+        {
+            std::unique_lock<std::mutex> lock(r->mu);
+            r->cv.wait(lock, [&] { return !r->jobs.empty(); });
+            job = std::move(r->jobs.front());
+            r->jobs.pop_front();
+        }
+        if (!sycl_stream_read_fill(job->dst, job->host, job->fd, job->file_off,
+                                   job->off, job->n)) {
+            GGML_LOG_ERROR("%s: read failed for streamed tensor\n", __func__);
+            std::exit(1);
+        }
+        sycl_stream_debug_fill(job->name, job->off, job->n, job->dst);
+        {
+            std::lock_guard<std::mutex> lock(job->mu);
+            job->done = true;
+        }
+        job->cv.notify_all();
+        {
+            std::lock_guard<std::mutex> lock(r->mu);
+            --r->outstanding;
+            auto it = r->outstanding_by_buf.find(job->owner);
+            if (it != r->outstanding_by_buf.end() && --it->second == 0) {
+                r->outstanding_by_buf.erase(it);
+            }
+            r->drained.notify_all();
+        }
+    }
+}
+
+// push one fill onto the device's reader pool; the staging ring bounds the
+// queue implicitly since every job owns a buffer and pick() blocks when
+// the ring is full
+static void sycl_stream_read_push(int device, const std::shared_ptr<sycl_stream_read_job> & job) {
+    sycl_stream_readers & r = sycl_stream_readers_for(device);
+    {
+        std::lock_guard<std::mutex> lock(r.mu);
+        if (!r.started) {
+            r.started = true;
+            const int n = sycl_stream_read_threads();
+            r.th.reserve(n);
+            for (int i = 0; i < n; i++) {
+                r.th.emplace_back(sycl_stream_reader_run, &r);
+            }
+        }
+        r.jobs.push_back(job);
+        r.outstanding++;
+        r.outstanding_by_buf[job->owner]++;
+    }
+    r.cv.notify_one();
+}
+
+// wait until every queued fill *for this buffer* has finished writing its
+// staging buffer; must run before freeing a ring or the pool the copies
+// write into. The pool is per device and shared by every live model, so a
+// device-wide wait could be starved forever by another model's fills
+static void sycl_stream_read_drain(int device, ggml_backend_buffer_t buffer) {
+    if (device < 0 || device >= GGML_SYCL_MAX_DEVICES) {
+        return;
+    }
+    sycl_stream_readers & r = sycl_stream_readers_for(device);
+    std::unique_lock<std::mutex> lock(r.mu);
+    r.drained.wait(lock, [&] {
+        auto it = r.outstanding_by_buf.find(buffer);
+        return it == r.outstanding_by_buf.end() || it->second == 0;
+    });
+}
+
+// submit dst <- staging copy gated on the fill. With reader threads the
+// fill runs off-thread and a host task inside the copy queue waits for it,
+// so the dispatch thread never blocks on file IO. Without them
+// (GGML_STREAM_READ_THREADS=0) the read stays inline.
+static sycl::event sycl_stream_copy_submit(sycl::queue * cq, char * dst,
+                                           sycl_stream_staging_buf & b,
+                                           const ggml_stream_src & src, size_t off, size_t n,
+                                           const std::vector<sycl::event> & deps,
+                                           int device, const char * name) {
+    if (sycl_stream_read_threads() > 0 && device >= 0 && device < GGML_SYCL_MAX_DEVICES) {
+        auto job = std::make_shared<sycl_stream_read_job>();
+        job->dst      = b.ptr;
+        job->host     = src.host_ptr;
+        job->fd       = src.fd;
+        job->file_off = src.file_off;
+        job->off      = off;
+        job->n        = n;
+        job->name     = name;
+        job->owner    = src.buffer;
+        sycl_stream_read_push(device, job);
+        sycl::event gate = cq->submit([job](sycl::handler & h) {
+            h.host_task([job] {
+                std::unique_lock<std::mutex> lock(job->mu);
+                job->cv.wait(lock, [&] { return job->done; });
+            });
+        });
+        std::vector<sycl::event> d = deps;
+        d.push_back(gate);
+        return cq->memcpy(dst, b.ptr, n, d);
+    }
+    if (!sycl_stream_read_fill(b.ptr, src.host_ptr, src.fd, src.file_off, off, n)) {
+        GGML_LOG_ERROR("%s: read failed for streamed tensor\n", __func__);
+        std::exit(1);
+    }
+    sycl_stream_debug_fill(name, off, n, b.ptr);
+    return deps.empty() ? cq->memcpy(dst, b.ptr, n) : cq->memcpy(dst, b.ptr, n, deps);
+}
