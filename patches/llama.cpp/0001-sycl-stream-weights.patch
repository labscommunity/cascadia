+// ---- disk-backed weight streaming (GGML_STREAM_WEIGHTS) ----
+// Layer weights registered by the loader are not uploaded at model load.
+// They share a fixed slot pool and are re-uploaded just-in-time before the
+// node that consumes them, tracked per-slot so any visit order is correct.
+// Fused-op paths are disabled while streaming because their covered nodes
+// are opaque to this scan.
+//
+// Async pipeline: uploads run on a dedicated in-order copy queue per
+// device out of a ring of pinned host staging buffers (GGML_STREAM_STAGING_BUFS,
+// default 8), so the host never blocks on the DMA itself. The consuming
+// node's kernels are gated by a compute-stream barrier on the slot's copy
+// event - the transfer overlaps surrounding compute. Slots come in
+// GGML_STREAM_SLOT_PARITY copies per weight index (default 2): while a
+// layer computes, the next layer's weights prefetch into the other parity
+// (GGML_STREAM_PREFETCH uploads enqueued per node, default 4). Every copy
+// depends on a compute-stream marker - the position behind all enqueued
+// work - so a prefetch can never overwrite a slot a live kernel reads.
+
+struct sycl_stream_pool {
+    bool built   = false;
+    int  device  = -1;
+    queue_ptr q  = nullptr;
+
+    struct entry {
+        ggml_stream_src src;
+        size_t          nbytes;
+        size_t          padded;
+        size_t          slot_off;
+        int             widx;
+        int             slot;
+    };
+
+    void *                                         pool = nullptr;
+    size_t                                         pool_bytes = 0;
+    int                                            parity = 1;
+    std::vector<size_t>                            slot_off;
+    std::vector<const ggml_tensor *>               slot_owner;
+    std::vector<sycl::event>                       slot_ev;
+    std::vector<uint64_t>                          slot_gen;
+    std::vector<uint64_t>                          slot_acked;
+    std::unordered_map<const ggml_tensor *, entry> map;
+    std::mutex                                     mu;
+    std::vector<sycl_stream_staging_buf>           staging;
+    int                                            staging_next = 0;
+    // marker = compute-stream position behind all enqueued work; copies
+    // depend on it. Stamped per layer per graph - by the first node of a
+    // layer every reader of the target parity is already enqueued.
+    sycl::event                                    marker;
+    uint64_t                                       marker_stamp = UINT64_MAX;
+    size_t                                         bytes_uploaded = 0;
+    size_t                                         uploads = 0;
+};
+static std::unordered_map<ggml_backend_buffer_t, sycl_stream_pool> g_swpools;
+static std::mutex g_swpools_mu;
+static std::atomic<uint64_t> g_stream_graph_seq{0};
+
+static int sycl_stream_slot_parity(void) {
+    static int v = -1;
+    if (v < 0) {
+        const char * e = getenv("GGML_STREAM_SLOT_PARITY");
+        v = e && atoi(e) > 0 ? atoi(e) : 2;
+        if (v > 8) {
+            v = 8;
+        }
+    }
+    return v;
+}
+
+static int sycl_stream_prefetch_max(void) {
+    static int v = -1;
+    if (v < 0) {
+        const char * e = getenv("GGML_STREAM_PREFETCH");
+        v = e ? atoi(e) : 4;
+        if (v < 0) {
+            v = 0;
+        }
+    }
+    return v;
+}
+
+static size_t sycl_stream_padded_size(const ggml_tensor * t) {
+    size_t size = ggml_nbytes(t);
+    if (ggml_is_quantized(t->type) && t->ne[0] % MATRIX_ROW_PADDING != 0) {
+        size += ggml_row_size(t->type, MATRIX_ROW_PADDING - t->ne[0] % MATRIX_ROW_PADDING);
+    }
+    return size;
+}
+
+static bool ggml_sycl_stream_build(sycl_stream_pool & sw, ggml_backend_buffer_t buf, int device, queue_ptr q) try {
+    int n0 = ggml_stream_snapshot(nullptr, nullptr, 0);
+    if (n0 <= 0) {
+        return false;
+    }
+
+    std::vector<const ggml_tensor *> ts0(n0);
+    std::vector<ggml_stream_src>     recs0(n0);
+    ggml_stream_snapshot(ts0.data(), recs0.data(), n0);
+
+    std::vector<const ggml_tensor *> ts;
+    std::vector<ggml_stream_src>     recs;
+    for (int i = 0; i < n0; i++) {
+        if (ts0[i]->buffer == buf) {
+            ts.push_back(ts0[i]);
+            recs.push_back(recs0[i]);
+        }
+    }
+    const int n = (int) ts.size();
+    if (n == 0) {
+        return false;
+    }
+
+    int nw = 0;
+    for (auto & r : recs) {
+        nw = std::max(nw, r.widx + 1);
+    }
+    std::vector<size_t> wmax(nw, 0);
+    for (int i = 0; i < n; i++) {
+        auto & e   = sw.map[ts[i]];
+        e.src      = recs[i];
+        e.widx     = recs[i].widx;
+        e.nbytes   = ggml_nbytes(ts[i]);
+        e.padded   = sycl_stream_padded_size(ts[i]);
+        e.slot     = e.widx * sycl_stream_slot_parity() + recs[i].layer % sycl_stream_slot_parity();
+        wmax[e.widx] = std::max(wmax[e.widx], e.padded);
+    }
+
+    const int parity = sycl_stream_slot_parity();
+    sw.parity = parity;
+    sw.slot_off.assign(nw * parity, 0);
+    size_t off = 0;
+    for (int w = 0; w < nw; w++) {
+        for (int p = 0; p < parity; p++) {
+            sw.slot_off[w * parity + p] = off;
+            off += GGML_PAD(wmax[w], SYCL_BUFFER_ALIGNMENT);
+        }
+    }
+    sw.pool_bytes = off;
+
+    sw.pool = ggml_sycl_malloc_device(sw.pool_bytes, *q);
+    if (sw.pool == nullptr) {
+        GGML_LOG_ERROR("%s: failed to allocate %zu bytes stream slot pool\n", __func__, sw.pool_bytes);
+        return false;
+    }
+
+    for (int i = 0; i < n; i++) {
+        auto & e = sw.map[ts[i]];
+        e.slot_off = sw.slot_off[e.slot];
+        ggml_tensor * t = const_cast<ggml_tensor *>(ts[i]);
+        t->data = (char *) sw.pool + e.slot_off;
+        if (t->extra) {
+            ((ggml_tensor_extra_gpu *) t->extra)->data_device[device] = t->data;
+        }
+    }
+
+    sw.slot_owner.assign(nw * parity, nullptr);
+    sw.slot_ev.assign(nw * parity, sycl::event());
+    sw.slot_gen.assign(nw * parity, 0);
+    sw.slot_acked.assign(nw * parity, 0);
+    sw.staging.assign(sycl_stream_staging_nbufs(), sycl_stream_staging_buf{});
+    sw.device = device;
+    sw.built  = true;
+    // fprintf on purpose: the server hides GGML_LOG_INFO at default verbosity
+    fprintf(stderr, "%s: stream slots %.2f MiB (%d slots, %d streamed tensors, parity %d)\n",
+            __func__, sw.pool_bytes / 1048576.0, nw * parity, n, parity);
+    return true;
+}
+catch (sycl::exception const &exc) {
+    std::cerr << exc.what() << "Exception caught at file:" << __FILE__
+              << ", line:" << __LINE__ << std::endl;
+    return false;
+}
+
+// the stream position behind everything enqueued so far; copies depend on
+// it so a re-upload never overtakes a kernel still reading the slot. The
+// stamp refreshes it once per layer per graph: all readers of the target
+// parity were enqueued before the layer's first node is scanned.
+static const sycl::event & sycl_stream_marker(sycl_stream_pool & sw, queue_ptr q, uint64_t stamp) {
+    if (sw.marker_stamp != stamp) {
+        sw.marker = q->ext_oneapi_submit_barrier();
+        sw.marker_stamp = stamp;
+    }
+    return sw.marker;
+}
+
+static void ggml_sycl_stream_upload_one(sycl_stream_pool & sw, const ggml_tensor * t,
+                                        const std::vector<sycl::event> & deps) {
+    auto it = sw.map.find(t);
+    if (it == sw.map.end()) {
+        return;
+    }
+    auto & e = it->second;
+    char * dst = (char *) sw.pool + e.slot_off;
+
+    sycl::queue * cq = sycl_stream_copy_queue(sw.device);
+    const int   bi = sycl_stream_staging_pick(sw.staging, sw.staging_next, cq, e.nbytes);
+    char *      buf = sw.staging[bi].ptr;
+
+    // L0 cannot USM-memcpy from file-mapped pages - stage through a plain
+    // host buffer first (same workaround as ggml_backend_sycl_buffer_set_tensor)
+    if (e.src.host_ptr != nullptr) {
+        memcpy(buf, e.src.host_ptr, e.nbytes);
+    } else {
+        size_t got = 0;
+        while (got < e.nbytes) {
+#ifdef _WIN32
+            // UCRT has no pread; do a positioned ReadFile on the fd's OS
+            // handle (does not disturb the CRT file position)
+            HANDLE h = (HANDLE) _get_osfhandle(e.src.fd);
+            if (h == INVALID_HANDLE_VALUE) {
+                GGML_LOG_ERROR("%s: invalid handle for streamed tensor\n", __func__);
+                std::exit(1);
+            }
+            size_t chunk = e.nbytes - got;
+            if (chunk > (size_t) 0x7FFFFFFF) {
+                chunk = (size_t) 0x7FFFFFFF;
+            }
+            OVERLAPPED ov;
+            memset(&ov, 0, sizeof(ov));
+            const uint64_t off = e.src.file_off + got;
+            ov.Offset     = (DWORD) (off & 0xFFFFFFFFu);
+            ov.OffsetHigh = (DWORD) (off >> 32);
+            DWORD rd = 0;
+            if (!ReadFile(h, buf + got, (DWORD) chunk, &rd, &ov)) {
+                GGML_LOG_ERROR("%s: ReadFile failed for streamed tensor\n", __func__);
+                std::exit(1);
+            }
+            const int r = (int) rd;
+#else
+            const ssize_t r = pread(e.src.fd, buf + got, e.nbytes - got,
+                                    (off_t) (e.src.file_off + got));
+#endif
+            if (r <= 0) {
+                GGML_LOG_ERROR("%s: pread failed for streamed tensor\n", __func__);
+                std::exit(1);
+            }
+            got += (size_t) r;
+        }
+        if (getenv("GGML_STREAM_DEBUG")) {
+            uint64_t h = 1469598103934665603ull;
+            for (size_t b = 0; b < e.nbytes; b += 4096) { h = (h ^ (uint8_t) buf[b]) * 1099511628211ull; }
+            fprintf(stderr, "[sw] %s off=%zu n=%zu fnv=%llx\n", t->name, e.src.file_off, e.nbytes,
+                    (unsigned long long) h);
+        }
+    }
+    sycl::event ev = deps.empty()
+                   ? cq->memcpy(dst, buf, e.nbytes)
+                   : cq->memcpy(dst, buf, e.nbytes, deps);
+    sw.staging[bi].ev = ev;
+    sw.staging[bi].live = true;
+    if (e.padded > e.nbytes) {
+        ev = cq->memset(dst + e.nbytes, 0, e.padded - e.nbytes, {ev});
+    }
+    sw.slot_ev[e.slot] = ev;
+    sw.slot_gen[e.slot]++;
+    // raw file bytes were uploaded - the in-place reorder optimization must run again
+    if (t->extra) {
+        ((ggml_tensor_extra_gpu *) t->extra)->optimized_feature.reorder = false;
+    }
+    sw.bytes_uploaded += e.nbytes;
+    sw.uploads++;
+}
+
+// pool lookup + lazy build shared by the needed-scan and the prefetch
+static sycl_stream_pool * ggml_sycl_stream_pool_for(ggml_backend_buffer_t buf) {
+    std::lock_guard<std::mutex> lock(g_swpools_mu);
+    return &g_swpools[buf];
+}
+
+static bool ggml_sycl_stream_pool_ready(sycl_stream_pool & sw, ggml_backend_buffer_t buf) {
+    if (sw.built) {
+        return true;
+    }
+    auto * bctx = (ggml_backend_sycl_buffer_context *) buf->context;
+    sw.q = bctx->stream;
+    return ggml_sycl_stream_build(sw, buf, bctx->device, sw.q);
+}
+
+// upload s into its slot when not resident; deps (optional) receives the
+// slot's last write event for the consumer barrier. returns true when an
+// upload was enqueued
+static bool ggml_sycl_stream_ensure(sycl_stream_pool & sw, const ggml_tensor * s,
+                                    queue_ptr q, uint64_t stamp, std::vector<sycl::event> * deps) {
+    auto it = sw.map.find(s);
+    if (it == sw.map.end()) {
+        return false;
+    }
+    auto & e = it->second;
+    if (sw.slot_owner[e.slot] != s) {
+        ggml_sycl_stream_upload_one(sw, s, { sycl_stream_marker(sw, q, stamp) });
+        sw.slot_owner[e.slot] = s;
+        if (deps != nullptr) {
+            deps->push_back(sw.slot_ev[e.slot]);
+            sw.slot_acked[e.slot] = sw.slot_gen[e.slot];
+        }
+        return true;
+    }
+    if (deps != nullptr && sw.slot_gen[e.slot] != sw.slot_acked[e.slot]) {
+        deps->push_back(sw.slot_ev[e.slot]);
+        sw.slot_acked[e.slot] = sw.slot_gen[e.slot];
+    }
+    return false;
+}
+
+// streamed weight tensors node n consumes (view-chased roots on sycl
+// buffers); nsrc receives the count
+static void ggml_sycl_stream_sources(const ggml_tensor * n,
+                                     const ggml_tensor ** srcs, int * nsrc) {
+    *nsrc = 0;
+    for (int j = 0; j < GGML_MAX_SRC && n->src[j] != nullptr; j++) {
+        const ggml_tensor * s = n->src[j];
+        while (s->view_src != nullptr) {
+            s = s->view_src;
+        }
+        const ggml_stream_src * rec = ggml_stream_find(s);
+        if (rec == nullptr || s->buffer == nullptr || !ggml_backend_buffer_is_sycl(s->buffer)) {
+            continue;
+        }
+        srcs[(*nsrc)++] = s;
+    }
+}
+
+static void ggml_sycl_stream_node(ggml_backend_sycl_context * sycl_ctx, const ggml_tensor * n,
+                                  uint64_t graph_seq, int * cur_layer) {
+    const ggml_tensor * srcs[GGML_MAX_SRC];
+    int nsrc = 0;
+    ggml_sycl_stream_sources(n, srcs, &nsrc);
+    if (nsrc == 0) {
+        return;
+    }
+    std::vector<sycl::event> deps;
+    deps.reserve(nsrc);
+    for (int k = 0; k < nsrc; k++) {
+        const ggml_tensor * s = srcs[k];
+        const ggml_stream_src * rec = ggml_stream_find(s);
+        if (cur_layer != nullptr && rec->layer > *cur_layer) {
+            *cur_layer = rec->layer;
+        }
+        sycl_stream_pool * swp = ggml_sycl_stream_pool_for(s->buffer);
+        std::unique_lock<std::mutex> lock(swp->mu);
+        if (!ggml_sycl_stream_pool_ready(*swp, s->buffer)) {
+            continue;
+        }
+        const uint64_t stamp = (graph_seq << 32) | (uint64_t) (rec->layer + 1);
+        ggml_sycl_stream_ensure(*swp, s, sycl_ctx->stream(), stamp, &deps);
+    }
+    if (!deps.empty()) {
+        sycl_ctx->stream()->ext_oneapi_submit_barrier(deps);
+    }
+}
+
+// enqueue uploads for the next streamed layer while the current layer's
+// kernels run; scans from node `from`, enqueues at most `budget` uploads,
+// returns the node index to resume from on the next call
+static int ggml_sycl_stream_prefetch(ggml_backend_sycl_context * sycl_ctx, ggml_cgraph * cgraph,
+                                     int from, int cur_layer, uint64_t graph_seq, int budget) {
+    int j      = from;
+    int target = cur_layer + 1;
+    for (; j < cgraph->n_nodes && budget > 0; j++) {
+        const ggml_tensor * srcs[GGML_MAX_SRC];
+        int nsrc = 0;
+        ggml_sycl_stream_sources(cgraph->nodes[j], srcs, &nsrc);
+        bool stop = false;
+        for (int k = 0; k < nsrc; k++) {
+            const ggml_stream_src * rec = ggml_stream_find(srcs[k]);
+            if (target <= 0) {
+                target = rec->layer;   // first streamed layer in the graph
+            }
+            if (rec->layer > target) {
+                stop = true;   // deeper layers share a parity slot already in flight
+                break;
+            }
+            if (rec->layer != target) {
+                continue;
+            }
+            sycl_stream_pool * swp = ggml_sycl_stream_pool_for(srcs[k]->buffer);
+            std::unique_lock<std::mutex> lock(swp->mu);
+            if (!ggml_sycl_stream_pool_ready(*swp, srcs[k]->buffer)) {
+                continue;
+            }
+            const uint64_t stamp = (graph_seq << 32) | (uint64_t) (target + 1);
+            if (ggml_sycl_stream_ensure(*swp, srcs[k], sycl_ctx->stream(), stamp, nullptr)) {
+                budget--;
+            }
+        }
+        if (stop) {
+            break;
+        }
+    }
+    return j;
+}
+
+static void ggml_sycl_stream_buffer_teardown(ggml_backend_buffer_t buffer, queue_ptr q) {
+    if (!q) {
+        return;
+    }
+    // drain in-flight kernels/memcpys before freeing the device memory
+    // their reads/writes may still target
+    q->wait();
+    sycl_stream_pool * swp = nullptr;
+    {
+        std::lock_guard<std::mutex> lock(g_swpools_mu);
+        auto it = g_swpools.find(buffer);
+        if (it != g_swpools.end()) {
+            swp = &it->second;
+        }
+    }
+    if (swp != nullptr) {
+        std::lock_guard<std::mutex> lock(swp->mu);
+        // copies still in flight read the staging ring and write the pool
+        sycl::queue * cq = swp->device >= 0 ? sycl_stream_copy_queue(swp->device) : nullptr;
+        if (cq != nullptr) {
+            cq->wait();
+        }
+        if (swp->pool != nullptr) {
+            ggml_sycl_free_device(swp->pool, *q);
+            swp->pool = nullptr;
+        }
+        if (cq != nullptr) {
+            for (auto & b : swp->staging) {
+                if (b.ptr != nullptr) {
+                    sycl::free(b.ptr, cq->get_context());
+                    b.ptr = nullptr;
+                }
+            }
+        }
+        std::lock_guard<std::mutex> mlock(g_swpools_mu);
+        g_swpools.erase(buffer);
+    }
+}
