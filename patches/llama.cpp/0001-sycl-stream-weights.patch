 #ifdef __APPLE__
@@ -2429,3 +2441,200 @@ ggml_backend_buffer_t ggml_backend_cpu_buffer_from_ptr(void * ptr, size_t size)
     GGML_ASSERT((uintptr_t)ptr % TENSOR_ALIGNMENT == 0 && "buffer pointer must be aligned");
     return ggml_backend_buffer_init(ggml_backend_cpu_buffer_from_ptr_type(), ggml_backend_cpu_buffer_from_ptr_i, ptr, size);
 }
+
+// disk-backed weight streaming registry
+
+static int ggml_stream_env_flag(void) {
+    static int v = -1;
+    if (v < 0) {
+        const char * e = getenv("GGML_STREAM_WEIGHTS");
+        v = (e && atoi(e) != 0) ? 1 : 0;
+    }
+    return v;
+}
+
+static size_t ggml_stream_min_bytes(void) {
+    static size_t v = 0;
+    if (v == 0) {
+        const char * e = getenv("GGML_STREAM_MIN_KB");
+        v = e && atoi(e) > 0 ? (size_t) atoi(e) * 1024 : 256 * 1024;
+    }
+    return v;
+}
+
+static int ggml_stream_parse_layer(const char * name) {
+    if (strncmp(name, "blk.", 4) != 0) {
+        return -1;
+    }
+    const char * p = name + 4;
+    if (*p < '0' || *p > '9') {
+        return -1;
+    }
+    char * end = NULL;
+    long l = strtol(p, &end, 10);
+    if (end == NULL || *end != '.') {
+        return -1;
+    }
+    return (int) l;
+}
+
+// GGML_STREAM_WEIGHTS only arms streaming for the process. Every decision
+// that depends on a model (which layers stay resident, whether it fits) is
+// recorded in that load's plan, and the compute path keys off live
+// registrations: a draft model or a server-side model switch must not
+// inherit another load's decision
+int ggml_stream_weights_enabled(void) {
+    return ggml_stream_env_flag();
+}
+
+static std::unordered_map<const ggml_tensor *, ggml_stream_src> g_stream_map;
+static std::mutex g_stream_mu;
+static std::unordered_set<std::string> g_stream_planned;
+static std::unordered_map<int, int> g_stream_fds;
+// g_stream_map.size(), readable without the lock from the dispatch path
+static std::atomic<int> g_stream_n_registered{0};
+
+int ggml_stream_active(void) {
+    return ggml_stream_env_flag() && g_stream_n_registered.load(std::memory_order_acquire) > 0;
+}
+
+void ggml_stream_plan_keep_resident(int n) {
+    std::lock_guard<std::mutex> lock(g_stream_mu);
+    for (auto it = g_stream_planned.begin(); it != g_stream_planned.end();) {
+        it = ggml_stream_parse_layer(it->c_str()) < n ? g_stream_planned.erase(it) : std::next(it);
+    }
+}
+
+void ggml_stream_plan_clear(void) {
+    std::lock_guard<std::mutex> lock(g_stream_mu);
+    g_stream_planned.clear();
+}
+
+void ggml_stream_plan(const char * name) {
+    if (name == NULL) {
+        return;
+    }
+    std::lock_guard<std::mutex> lock(g_stream_mu);
+    g_stream_planned.insert(name);
+}
+
+void ggml_stream_plan_reset(void) {
+    std::lock_guard<std::mutex> lock(g_stream_mu);
+    // names are per-load scratch; the registrations and dup()d descriptors
+    // of a still-live model must NOT be touched here (a draft model or a
+    // server-side model switch can load while another model streams) - the
+    // per-buffer purge in ggml_stream_purge_buffer owns that cleanup
+    g_stream_planned.clear();
+    // g_stream_fds is only the load-time orig->dup dedupe: the loader's
+    // source fds die with it, so any entry left from a previous load maps
+    // a dead number that a new model's file may legitimately reuse. The
+    // dup fds stay open via their registrations; never close them here.
+    g_stream_fds.clear();
+}
+
+void ggml_stream_purge_buffer(struct ggml_backend_buffer * buffer) {
+    std::lock_guard<std::mutex> lock(g_stream_mu);
+    std::unordered_map<int, int> users;  // dup fd -> live registrations
+    for (auto & kv : g_stream_map) {
+        users[kv.second.fd]++;
+    }
+    for (auto it = g_stream_map.begin(); it != g_stream_map.end();) {
+        if (it->second.buffer != buffer) {
+            ++it;
+            continue;
+        }
+        if (--users[it->second.fd] == 0 && it->second.fd >= 0) {
+            // close the dup descriptor unconditionally: plan_reset may have
+            // cleared g_stream_fds since this registration, so the dedupe
+            // lookup cannot be trusted to still hold the fd
+#ifdef _WIN32
+            _close(it->second.fd);
+#else
+            close(it->second.fd);
+#endif
+            for (auto fit = g_stream_fds.begin(); fit != g_stream_fds.end();) {
+                fit = fit->second == it->second.fd ? g_stream_fds.erase(fit) : std::next(fit);
+            }
+        }
+        it = g_stream_map.erase(it);
+        g_stream_n_registered.fetch_sub(1, std::memory_order_release);
+    }
+}
+
+static bool ggml_stream_is_planned(const ggml_tensor * tensor) {
+    std::lock_guard<std::mutex> lock(g_stream_mu);
+    return g_stream_planned.count(tensor->name) != 0;
+}
+
+int ggml_stream_dup_fd(int file_fd) {
+    std::lock_guard<std::mutex> lock(g_stream_mu);
+    auto it = g_stream_fds.find(file_fd);
+    if (it != g_stream_fds.end()) {
+        return it->second;
+    }
+#ifdef _WIN32
+    const int fd = _dup(file_fd);
+#else
+    const int fd = dup(file_fd);
+#endif
+    if (fd < 0) {
+        throw std::runtime_error(std::string("stream-weights: dup() of the model file failed: ") + strerror(errno) +
+                                 " (streaming keeps one descriptor per model file; raise the open-file limit)");
+    }
+    g_stream_fds[file_fd] = fd;
+    return fd;
+}
+
+// true if the tensor would stream with no resident layers kept
+bool ggml_stream_is_streamable(const ggml_tensor * tensor) {
+    if (!ggml_stream_weights_enabled() || tensor == NULL) {
+        return false;
+    }
+    return ggml_stream_parse_layer(tensor->name) >= 0 &&
+           ggml_nbytes(tensor) >= ggml_stream_min_bytes();
+}
+
+// the plan already excludes this load's resident layers
+bool ggml_stream_is_weight(const ggml_tensor * tensor) {
+    return ggml_stream_is_streamable(tensor) && ggml_stream_is_planned(tensor);
+}
+
+void ggml_stream_register(ggml_tensor * tensor, const void * host_ptr, int fd, size_t file_off) {
+    const int layer = ggml_stream_parse_layer(tensor->name);
+    if (layer < 0) {
+        return;
+    }
+    std::lock_guard<std::mutex> lock(g_stream_mu);
+    // index within (owning buffer, layer): another model's registrations
+    // must not shift this buffer's slot layout
+    int widx = 0;
+    for (auto & kv : g_stream_map) {
+        if (kv.second.layer == layer && kv.second.buffer == tensor->buffer && kv.first != tensor) {
+            widx++;
+        }
+    }
+    const bool fresh = g_stream_map.find(tensor) == g_stream_map.end();
+    g_stream_map[tensor] = { host_ptr, fd, file_off, layer, widx, tensor->buffer };
+    if (fresh) {
+        g_stream_n_registered.fetch_add(1, std::memory_order_release);
+    }
+}
+
+const ggml_stream_src * ggml_stream_find(const ggml_tensor * tensor) {
+    std::lock_guard<std::mutex> lock(g_stream_mu);
+    auto it = g_stream_map.find(tensor);
+    return it == g_stream_map.end() ? nullptr : &it->second;
+}
+
+int ggml_stream_snapshot(const ggml_tensor ** tensors, ggml_stream_src * recs, int max_n) {
+    std::lock_guard<std::mutex> lock(g_stream_mu);
+    int n = 0;
+    for (auto & kv : g_stream_map) {
+        if (n < max_n && tensors && recs) {
+            tensors[n] = kv.first;
+            recs[n] = kv.second;
+        }
+        n++;
+    }
+    return n;
+}
