+// ---- router-aware MoE expert streaming (automatic detection) ----
+// A "routed expert tensor" is any streamed weight consumed by
+// GGML_OP_MUL_MAT_ID with an expert-stack axis (ne[2] > 1). Detection is
+// purely structural (executed graph + tensor shape), so every MoE the
+// runtime can run is covered with no model/architecture list. The set is
+// populated by the pre-scan in ggml_backend_sycl_graph_compute_impl()
+// before any stream slot pool is built. The arenas and counters live with
+// the stream pool below; these early declarations are shared with
+// should_reorder_tensor() and ggml_sycl_mul_mat_id().
+static std::unordered_set<const ggml_tensor *> g_expert_tensors;
+static std::mutex                         g_expert_mu;
+// while set, suppress the in-place weight reorder optimization: expert
+// slices live in shared slot arenas whose raw file layout must be preserved
+static bool                               g_expert_slice_guard = false;
+
+
 static bool should_reorder_tensor(ggml_backend_sycl_context& ctx, const ggml_tensor * dst) {
+    if (g_expert_slice_guard) {
+        return false;
+    }
     return g_ggml_sycl_enable_optimize && //allow optimize, controlled by $GGML_SYCL_ENABLE_OPT
            ctx.opt_feature.reorder &&      //allow this device due to good perf, skip the devices with bad perf.
            dst->op == GGML_OP_MUL_MAT &&   //limit to some supported cases of Q4_0, to do for more cases.
@@ -4780,6 +4798,266 @@
