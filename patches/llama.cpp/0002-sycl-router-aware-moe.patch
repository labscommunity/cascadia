+// slices live in shared slot arenas whose raw file layout must be preserved
+// (per-thread: concurrent graphs must not leak the guard across each other)
+static thread_local bool                  g_expert_slice_guard = false;
+
+// clears g_expert_slice_guard on every exit path, including an unwind
+// into the function-level sycl::exception catch
+struct sycl_expert_slice_guard {
+    explicit sycl_expert_slice_guard(bool v) { g_expert_slice_guard = v; }
+    ~sycl_expert_slice_guard() { g_expert_slice_guard = false; }
+};
