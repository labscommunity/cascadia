{
  "policy": {
    "name": "xvla",
    "source": {
      "class_path": "lerobot.policies.xvla.modeling_xvla.XVLAPolicy",
      "hf_id": "lerobot/xvla-libero",
      "domain_id": 3,
      "libero_adapter": true
    }
  },
  "model": {
    "runner": {
      "class_path": "physicalai.inference.runners.single_pass.SinglePass"
    },
    "artifacts": {
      "openvino": "xvla.xml"
    },
    "preprocessors": [
      {
        "type": "image_flip",
        "cameras": [
          "image2"
        ]
      },
      {
        "type": "smolvla_resize",
        "image_resolution": [
          224,
          224
        ],
        "image_key_reorder_map": {},
        "num_cameras": 0
      },
      {
        "type": "noise",
        "shape": [
          30,
          20
        ]
      },
      {
        "type": "ov_tokenizer",
        "artifact": "tokenizer.xml"
      }
    ],
    "postprocessors": [
      {
        "type": "xvla_rotation_6d_to_axis_angle",
        "expected_action_dim": 10
      }
    ],
    "input_features": [
      {
        "class_path": "physicalai.inference.data.features.InferenceFeature",
        "init_args": {
          "ftype": "VISUAL",
          "shape": [
            3,
            224,
            224
          ],
          "name": "images.image",
          "dtype": "float32"
        }
      },
      {
        "class_path": "physicalai.inference.data.features.InferenceFeature",
        "init_args": {
          "ftype": "VISUAL",
          "shape": [
            3,
            224,
            224
          ],
          "name": "images.image2",
          "dtype": "float32"
        }
      },
      {
        "class_path": "physicalai.inference.data.features.InferenceFeature",
        "init_args": {
          "ftype": "STATE",
          "shape": [
            8
          ],
          "name": "state",
          "dtype": "float32"
        }
      },
      {
        "class_path": "physicalai.inference.data.features.InferenceFeature",
        "init_args": {
          "ftype": "LANGUAGE",
          "shape": [
            50
          ],
          "name": "task",
          "dtype": "string"
        }
      },
      {
        "class_path": "physicalai.inference.data.features.InferenceFeature",
        "init_args": {
          "ftype": "COMMON",
          "shape": [
            30,
            20
          ],
          "name": "noise",
          "dtype": "float32"
        }
      }
    ],
    "output_features": [
      {
        "class_path": "physicalai.inference.data.features.InferenceFeature",
        "init_args": {
          "ftype": "ACTION",
          "shape": [
            30,
            7
          ],
          "name": "action",
          "dtype": "float32"
        }
      }
    ]
  },
  "format": "policy_package",
  "version": "1.0"
}