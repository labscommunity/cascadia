# Inkling fleet settings pushed from rank 0 (sourced by run.sh after rank.env; shell syntax, RANK is available).
# 2026-09-19: fused expert layers give NaN at f16 on the deeper layers and are slower than the CPU path at f32
# (measured 1.66 vs 1.81 tok/s single, 4.2 vs 4.9 aggregate at 16 streams), so experts run on the CPU.
# Attention and the output head on the iGPU are correct on all 66 layers and cut time to first token.
CASCADIA_INKLING_OV_MOE=0
CASCADIA_INKLING_OV_MOE_LAYERS=
CASCADIA_INKLING_OV_MOE_PRECISION=f32
CASCADIA_INKLING_OV_ATTN=1
CASCADIA_INKLING_OV_ATTN_DROP_RUST=1
CASCADIA_INKLING_OV_HEAD=1
# 11 frames are in flight at once, so 16 streams left each box 1-2 rows per step; more slots let the boxes batch.
CASCADIA_STREAMS=48
CASCADIA_API_MAX_CONCURRENT=192
# 2026-09-20: every rank logs where its time goes once per 10 s while frames flow (relayed by the beacon: beacon.py --top)
CASCADIA_STAGE_PROFILE_SECS=10
# autolab 002a: the last rank answers rank 0 directly instead of through the nine ranks in between
CASCADIA_STREAMS_RETURN_PORT=9115
CASCADIA_STREAMS_RETURN_HOST=${FLEET}-rank-$((TOTAL-1))
# autolab 002b: a lone stream's next tokens are guessed (n-gram) and sent behind the real frame
CASCADIA_STREAMS_SPEC=1
