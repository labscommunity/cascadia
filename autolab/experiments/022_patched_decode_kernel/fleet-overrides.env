# Inkling fleet settings pushed from rank 0 (sourced by run.sh after rank.env; shell syntax, RANK is available).
# 2026-09-19: fused expert layers give NaN at f16 on the deeper layers and are slower than the CPU path at f32
# (measured 1.66 vs 1.81 tok/s single, 4.2 vs 4.9 aggregate at 16 streams), so experts run on the CPU.
# Attention and the output head on the iGPU are correct on all 66 layers and cut time to first token.
CASCADIA_INKLING_OV_MOE=0
CASCADIA_INKLING_OV_MOE_LAYERS=
CASCADIA_INKLING_OV_MOE_PRECISION=f32
CASCADIA_INKLING_OV_ATTN=1
CASCADIA_INKLING_OV_ATTN_DROP_RUST=1
CASCADIA_INKLING_OV_HEAD=1
# 11 frames are in flight at once, so 16 streams left each box 1-2 rows per step; more slots let the boxes batch.
CASCADIA_STREAMS=360
CASCADIA_API_MAX_CONCURRENT=512
# 2026-09-20: every rank logs where its time goes once per 10 s while frames flow (relayed by the beacon: beacon.py --top)
CASCADIA_STAGE_PROFILE_SECS=10
# autolab 002a: the last rank answers rank 0 directly instead of through the nine ranks in between
CASCADIA_STREAMS_RETURN_PORT=9115
CASCADIA_STREAMS_RETURN_HOST=${FLEET}-rank-$((TOTAL-1))
# autolab 002b: a lone stream's next tokens are guessed (n-gram) and sent behind the real frame
CASCADIA_STREAMS_SPEC=1
# autolab 004: every rank reads its experts into the resident cache while loading
CASCADIA_INKLING_PREWARM=1
# autolab 005: what requests taught the drafter survives restarts; 192 slots for a 176-stream phase
CASCADIA_STREAMS_SPEC_TABLE=/opt/cascadia-inkling/spec-ngrams.bin
# autolab 006: the last rank also holds the output head; with the head on the iGPU its bf16 table is a fallback only: keep it file-backed
[ "$RANK" = "$((TOTAL-1))" ] && CASCADIA_INKLING_MMAP_HEAD=1
# autolab 008b: every MoE layer of every rank runs on the iGPU at f16. run.sh generates the IRs a box does not have yet
# (about a minute each, once), layer 8 with its up scales x 2^-4 (its shared expert passes f16's range inside the expert),
# and the iGPU may own 52 GiB (54 on the last rank, which also holds the output head) for this boot.
_ALL=""; _l="$LAYER_START"
while [ "$_l" -lt "$LAYER_END" ]; do case "$_l" in 0|1) ;; *) _ALL="${_ALL:+$_ALL,}$_l" ;; esac; _l=$((_l+1)); done
CASCADIA_INKLING_OV_MOE=1
CASCADIA_INKLING_OV_MOE_PRECISION=f16
CASCADIA_INKLING_OV_MOE_LAYERS="$_ALL"
CASCADIA_FUSE_LAYERS="$_ALL"
CASCADIA_FUSE_UP_SHIFT="8:4"
CASCADIA_GPU_PAGES_GIB=52
[ "$RANK" = "$((TOTAL-1))" ] && CASCADIA_GPU_PAGES_GIB=54
# autolab 009: rank 0's two dense layers run on the iGPU as one call per frame (run.sh generates the two small IRs)
CASCADIA_FUSE_DENSE="0,1"
CASCADIA_INKLING_OV_DENSE=1
# autolab 009: with ~50 GiB owned by the iGPU driver the kernel swapped those pages at the default swappiness (60):
# 800-4200 swap-ins a second and single frames of 0.5-1.8 s. Not persistent across a reboot.
sysctl -q -w vm.swappiness=1 > /dev/null 2>&1 || true

# autolab 015 (every rank): cdc_ncm holds a small frame back for up to 3 x tx_timer_usecs (400 us) hoping to fill a
# USB transfer: 014 measured 3.3 ms per LAN round trip, 2.0 ms with ONE side's timer off. 0 = "no aggregation"
# (documented sysfs knob, not persistent across a reboot or a re-plug). The round trip as it is 7 minutes after
# the worker started leaves the box on a "stage profile" line (autolab/bench/probe_read.py P15).
_if=$(ip -o -4 route show to default 2>/dev/null | awk '{print $5; exit}')
[ -n "$_if" ] && [ -w "/sys/class/net/$_if/cdc_ncm/tx_timer_usecs" ] && echo 0 > "/sys/class/net/$_if/cdc_ncm/tx_timer_usecs" 2>/dev/null
(
  set +e +u
  sleep 420
  IF=$(ip -o -4 route show to default 2>/dev/null | awk '{print $5; exit}')
  PEER="${FLEET}-rank-$(( (RANK + 1) % TOTAL ))"
  us() { awk -F'[=/ ]+' '/^rtt|^round-trip/ {printf "%d %d %d", $6*1000, $7*1000, $8*1000}'; }
  set -- $(ping -c 16 -i 0.5 -q "$PEER" 2>/dev/null | us) x x x; IDLE_MIN=$1; IDLE_AVG=$2
  set -- $(ping -c 300 -i 0.002 -q "$PEER" 2>/dev/null | us) x x x; FAST_MIN=$1; FAST_AVG=$2; FAST_MAX=$3
  set -- $(ping -c 100 -i 0.005 -s 12000 -q "$PEER" 2>/dev/null | us) x x x; BIG_MIN=$1; BIG_AVG=$2
  LINE="P15A probe stage profile ph=1 idle_min=$IDLE_MIN idle_avg=$IDLE_AVG fast_min=$FAST_MIN fast_avg=$FAST_AVG fast_max=$FAST_MAX big_min=$BIG_MIN big_avg=$BIG_AVG timer=$(cat "/sys/class/net/$IF/cdc_ncm/tx_timer_usecs" 2>/dev/null || echo 99999)"
  for _i in 1 2 3; do echo "$LINE"; sleep 4; done
) &
# autolab 015 (rank 0): a 0.6B drafter model beside the worker. Offline over 192 of this fleet's own responses (013)
# it names the model's next token 54 % of the time, the n-gram tables 30-38 %: single-stream speed is
# 1 / (a*T + (1-a)*L) with L ten times T. llama.cpp's server (official release b11056, CPU build) and Qwen3-0.6B
# Q4_K_M come through the lab's proxy, both pinned by sha256; the server runs unprivileged on 127.0.0.1:8099 inside
# the worker's unit (it stops and starts with it). No server, no harm: the engine falls back to the tables.
if [ "$RANK" = "0" ]; then
  CASCADIA_STREAMS_SPEC_LM=http://127.0.0.1:8099
  CASCADIA_STREAMS_SPEC_LM_TEMPLATE=qwen
  (
    set +e +u
    D=/opt/cascadia-inkling/drafter; PX=http://LAB-PROXY:PORT  # redacted in the repository; the published file (kept outside the work tree) names the lab proxy
    mkdir -p "$D"; cd "$D" || exit 0
    have() { [ -s "$2" ] && [ "$(sha256sum "$2" | cut -d' ' -f1)" = "$1" ]; }
    fetch() {  # sha256 url file
      have "$1" "$3" && return 0
      curl -fsSL --retry 3 --connect-timeout 20 --max-time 1500 -x "$PX" -o "$3.part" "$2"; _rc=$?
      have "$1" "$3.part" && mv -f "$3.part" "$3" && return 0
      rm -f "$3.part"; return $(( _rc ? _rc : 97 ))
    }
    fetch 74936888e975064d07e352745237508d4bef08d4b51843b01d011d58a4c4601a \
      https://github.com/ggml-org/llama.cpp/releases/download/b11056/llama-b11056-bin-ubuntu-x64.tar.gz llama.tar.gz; L=$?
    fetch 9acfc1e001311f34b4252001b626f2e466d592a42065f66571bff3790d4e1b14 \
      https://huggingface.co/bartowski/Qwen_Qwen3-0.6B-GGUF/resolve/main/Qwen_Qwen3-0.6B-Q4_K_M.gguf drafter.gguf; G=$?
    [ "$L" = 0 ] && { [ -x llama-b11056/llama-server ] || tar -xzf llama.tar.gz; }
    chmod -R a+rX "$D" 2>/dev/null
    PRIV=0; command -v setpriv > /dev/null 2>&1 && PRIV=1
    MISSING=$(ldd llama-b11056/llama-server 2>/dev/null | grep -c "not found")
    LINE="P15L probe stage profile ph=5 llama_rc=$L gguf_rc=$G setpriv=$PRIV libs_missing=${MISSING:-99}"
    for _i in 1 2 3; do echo "$LINE"; sleep 2; done
    [ "$L" = 0 ] && [ "$G" = 0 ] && [ "$PRIV" = 1 ] || exit 0
    exec setpriv --reuid=65534 --regid=65534 --clear-groups llama-b11056/llama-server -m drafter.gguf \
      --host 127.0.0.1 --port 8099 -c 8192 --parallel 1 -t 4 --no-webui > /dev/null 2>&1
  ) &
fi

# autolab 022: the GPU plugin's fused-MoE DECODE kernels, with their 32-bit expert offset fixed.
# OpenVINO 2026.3.1 indexes an expert's weights as `expert_id * expert_wei_size` in 32-bit ints: 9,437,184 bytes x id
# >= 228 passes INT_MAX and reads out of bounds (this model has 258 experts per layer, and the two shared ones, ids
# 256/257, are in EVERY token's list). That is why the decode path "crashes on this GPU" and why the fleet forces the
# op's prefill path (threshold 0), which costs ~1.5 ms of host work per call. The OpenCL source sits in the plugin
# library as text: a same-length patch (int -> long at 4 sites, original kept as .orig, sha256 checked before and
# after) fixes it. CANARY: rank 5 only. If its worker dies by a signal or restarts more than 8 times after the
# attempt, the next start puts the original library back and stays on the prefill path by itself.
if [ "$RANK" = "5" ]; then
  _lib=$(ls "$PREFIX"/ov/openvino_genai_*/runtime/lib/intel64/libopenvino_intel_gpu_plugin.so 2>/dev/null | head -1)
  _m="$PREFIX/decode-kernel-022"
  _n=$(( $(cat "$_m.starts" 2>/dev/null || echo 0) + 1 )); echo "$_n" > "$_m.starts"
  _died=0
  [ -e "$_m.trying" ] && _died=$(journalctl -u cascadia-inkling --since "@$(stat -c %Y "$_m.trying")" -q --no-pager 2>/dev/null | grep -c -E "code=dumped|code=killed|status=11/SEGV|status=6/ABRT|status=101")
  if [ -e "$_m.off" ] || { [ -e "$_m.trying" ] && { [ "$_n" -gt 8 ] || [ "${_died:-0}" -gt 0 ]; }; }; then
    : > "$_m.off"
    [ -s "$_lib.orig" ] && cp -f "$_lib.orig" "$_lib.tmp" && mv -f "$_lib.tmp" "$_lib"
    echo "P22X probe stage profile ph=9 reverted=1 starts=$_n died=${_died:-0}"
  elif [ -n "$_lib" ] && /usr/bin/python3 - "$_lib" 6f8bba74029e4fdf86fa8d57fabaae00c3a74ea880aaa8003270089763b1890e > "$_m.log" 2>&1 <<'PATCH_PY'
import hashlib, os, shutil, sys
# OpenVINO 2026.3.1 GPU plugin: the fused-MoE decode kernels index an expert's weights with a 32-bit product
# (expert_id * expert_wei_size): 9,437,184 bytes x id >= 228 passes INT_MAX and reads out of bounds. Same-length
# text patch of the embedded OpenCL source, 4 sites (gate/up and down kernels, u4 and u8 branches): int -> long.
lib = sys.argv[1]
ORIG = sys.argv[2]
A = b"const int expert_wei_size=INTERMEDIATE_SIZE * HIDDEN_SIZE"
B = b"const long expert_wei_size=INTERMEDIATE_SIZE *HIDDEN_SIZE"
assert len(A) == len(B)
data = open(lib, "rb").read()
sha = hashlib.sha256(data).hexdigest()
if data.count(B) == 4 and data.count(A) == 0:
    print("already patched", sha); sys.exit(0)
if sha != ORIG:
    print("unknown library", sha); sys.exit(3)
if data.count(A) != 4:
    print("unexpected site count", data.count(A)); sys.exit(4)
new = data.replace(A, B)
assert len(new) == len(data)
if not os.path.exists(lib + ".orig"):
    shutil.copy2(lib, lib + ".orig")
tmp = lib + ".tmp"
with open(tmp, "wb") as f:
    f.write(new); f.flush(); os.fsync(f.fileno())
os.chmod(tmp, os.stat(lib).st_mode & 0o7777)
os.replace(tmp, lib)
print("patched", hashlib.sha256(new).hexdigest()); sys.exit(0)
PATCH_PY
  then
    [ -e "$_m.trying" ] || : > "$_m.trying"
    OV_GPU_MOE_BATCHED_GEMV_THRESHOLD=32
    echo "P22T probe stage profile ph=1 patched=1 starts=$_n"
  else
    echo "P22F probe stage profile ph=8 patchfailed=1 starts=$_n"
  fi
fi
