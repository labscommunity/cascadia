# Inkling fleet settings pushed from rank 0 (sourced by run.sh after rank.env; shell syntax, RANK is available).
# 2026-09-19: fused expert layers give NaN at f16 on the deeper layers and are slower than the CPU path at f32
# (measured 1.66 vs 1.81 tok/s single, 4.2 vs 4.9 aggregate at 16 streams), so experts run on the CPU.
# Attention and the output head on the iGPU are correct on all 66 layers and cut time to first token.
CASCADIA_INKLING_OV_MOE=0
CASCADIA_INKLING_OV_MOE_LAYERS=
CASCADIA_INKLING_OV_MOE_PRECISION=f32
CASCADIA_INKLING_OV_ATTN=1
CASCADIA_INKLING_OV_ATTN_DROP_RUST=1
CASCADIA_INKLING_OV_HEAD=1
# 11 frames are in flight at once, so 16 streams left each box 1-2 rows per step; more slots let the boxes batch.
CASCADIA_STREAMS=360
CASCADIA_API_MAX_CONCURRENT=512
# 2026-09-20: every rank logs where its time goes once per 10 s while frames flow (relayed by the beacon: beacon.py --top)
CASCADIA_STAGE_PROFILE_SECS=10
# autolab 002a: the last rank answers rank 0 directly instead of through the nine ranks in between
CASCADIA_STREAMS_RETURN_PORT=9115
CASCADIA_STREAMS_RETURN_HOST=${FLEET}-rank-$((TOTAL-1))
# autolab 002b: a lone stream's next tokens are guessed (n-gram) and sent behind the real frame
CASCADIA_STREAMS_SPEC=1
# autolab 004: every rank reads its experts into the resident cache while loading
CASCADIA_INKLING_PREWARM=1
# autolab 005: what requests taught the drafter survives restarts; 192 slots for a 176-stream phase
CASCADIA_STREAMS_SPEC_TABLE=/opt/cascadia-inkling/spec-ngrams.bin
# autolab 006: the last rank also holds the output head; with the head on the iGPU its bf16 table is a fallback only: keep it file-backed
[ "$RANK" = "$((TOTAL-1))" ] && CASCADIA_INKLING_MMAP_HEAD=1
# autolab 008b: every MoE layer of every rank runs on the iGPU at f16. run.sh generates the IRs a box does not have yet
# (about a minute each, once), layer 8 with its up scales x 2^-4 (its shared expert passes f16's range inside the expert),
# and the iGPU may own 52 GiB (54 on the last rank, which also holds the output head) for this boot.
_ALL=""; _l="$LAYER_START"
while [ "$_l" -lt "$LAYER_END" ]; do case "$_l" in 0|1) ;; *) _ALL="${_ALL:+$_ALL,}$_l" ;; esac; _l=$((_l+1)); done
CASCADIA_INKLING_OV_MOE=1
CASCADIA_INKLING_OV_MOE_PRECISION=f16
CASCADIA_INKLING_OV_MOE_LAYERS="$_ALL"
CASCADIA_FUSE_LAYERS="$_ALL"
CASCADIA_FUSE_UP_SHIFT="8:4"
CASCADIA_GPU_PAGES_GIB=52
[ "$RANK" = "$((TOTAL-1))" ] && CASCADIA_GPU_PAGES_GIB=54
# autolab 009: rank 0's two dense layers run on the iGPU as one call per frame (run.sh generates the two small IRs)
CASCADIA_FUSE_DENSE="0,1"
CASCADIA_INKLING_OV_DENSE=1
# autolab 009: with ~50 GiB owned by the iGPU driver the kernel swapped those pages at the default swappiness (60):
# 800-4200 swap-ins a second and single frames of 0.5-1.8 s. Not persistent across a reboot.
sysctl -q -w vm.swappiness=1 > /dev/null 2>&1 || true

# autolab 015 (every rank): cdc_ncm holds a small frame back for up to 3 x tx_timer_usecs (400 us) hoping to fill a
# USB transfer: 014 measured 3.3 ms per LAN round trip, 2.0 ms with ONE side's timer off. 0 = "no aggregation"
# (documented sysfs knob, not persistent across a reboot or a re-plug). The round trip as it is 7 minutes after
# the worker started leaves the box on a "stage profile" line (autolab/bench/probe_read.py P15).
_if=$(ip -o -4 route show to default 2>/dev/null | awk '{print $5; exit}')
[ -n "$_if" ] && [ -w "/sys/class/net/$_if/cdc_ncm/tx_timer_usecs" ] && echo 0 > "/sys/class/net/$_if/cdc_ncm/tx_timer_usecs" 2>/dev/null
(
  set +e +u
  sleep 420
  IF=$(ip -o -4 route show to default 2>/dev/null | awk '{print $5; exit}')
  PEER="${FLEET}-rank-$(( (RANK + 1) % TOTAL ))"
  us() { awk -F'[=/ ]+' '/^rtt|^round-trip/ {printf "%d %d %d", $6*1000, $7*1000, $8*1000}'; }
  set -- $(ping -c 16 -i 0.5 -q "$PEER" 2>/dev/null | us) x x x; IDLE_MIN=$1; IDLE_AVG=$2
  set -- $(ping -c 300 -i 0.002 -q "$PEER" 2>/dev/null | us) x x x; FAST_MIN=$1; FAST_AVG=$2; FAST_MAX=$3
  set -- $(ping -c 100 -i 0.005 -s 12000 -q "$PEER" 2>/dev/null | us) x x x; BIG_MIN=$1; BIG_AVG=$2
  LINE="P15A probe stage profile ph=1 idle_min=$IDLE_MIN idle_avg=$IDLE_AVG fast_min=$FAST_MIN fast_avg=$FAST_AVG fast_max=$FAST_MAX big_min=$BIG_MIN big_avg=$BIG_AVG timer=$(cat "/sys/class/net/$IF/cdc_ncm/tx_timer_usecs" 2>/dev/null || echo 99999)"
  for _i in 1 2 3; do echo "$LINE"; sleep 4; done
) &
# autolab 015 (rank 0): a 0.6B drafter model beside the worker. Offline over 192 of this fleet's own responses (013)
# it names the model's next token 54 % of the time, the n-gram tables 30-38 %: single-stream speed is
# 1 / (a*T + (1-a)*L) with L ten times T. llama.cpp's server (official release b11056, CPU build) and Qwen3-0.6B
# Q4_K_M come through the lab's proxy, both pinned by sha256; the server runs unprivileged on 127.0.0.1:8099 inside
# the worker's unit (it stops and starts with it). No server, no harm: the engine falls back to the tables.
if [ "$RANK" = "0" ]; then
  CASCADIA_STREAMS_SPEC_LM=http://127.0.0.1:8099
  CASCADIA_STREAMS_SPEC_LM_TEMPLATE=qwen
  (
    set +e +u
    D=/opt/cascadia-inkling/drafter; PX=http://LAB-PROXY:PORT  # redacted in the repository; the published file (kept outside the work tree) names the lab proxy
    mkdir -p "$D"; cd "$D" || exit 0
    have() { [ -s "$2" ] && [ "$(sha256sum "$2" | cut -d' ' -f1)" = "$1" ]; }
    fetch() {  # sha256 url file
      have "$1" "$3" && return 0
      curl -fsSL --retry 3 --connect-timeout 20 --max-time 1500 -x "$PX" -o "$3.part" "$2"; _rc=$?
      have "$1" "$3.part" && mv -f "$3.part" "$3" && return 0
      rm -f "$3.part"; return $(( _rc ? _rc : 97 ))
    }
    fetch 74936888e975064d07e352745237508d4bef08d4b51843b01d011d58a4c4601a \
      https://github.com/ggml-org/llama.cpp/releases/download/b11056/llama-b11056-bin-ubuntu-x64.tar.gz llama.tar.gz; L=$?
    fetch 9acfc1e001311f34b4252001b626f2e466d592a42065f66571bff3790d4e1b14 \
      https://huggingface.co/bartowski/Qwen_Qwen3-0.6B-GGUF/resolve/main/Qwen_Qwen3-0.6B-Q4_K_M.gguf drafter.gguf; G=$?
    [ "$L" = 0 ] && { [ -x llama-b11056/llama-server ] || tar -xzf llama.tar.gz; }
    chmod -R a+rX "$D" 2>/dev/null
    PRIV=0; command -v setpriv > /dev/null 2>&1 && PRIV=1
    MISSING=$(ldd llama-b11056/llama-server 2>/dev/null | grep -c "not found")
    LINE="P15L probe stage profile ph=5 llama_rc=$L gguf_rc=$G setpriv=$PRIV libs_missing=${MISSING:-99}"
    for _i in 1 2 3; do echo "$LINE"; sleep 2; done
    [ "$L" = 0 ] && [ "$G" = 0 ] && [ "$PRIV" = 1 ] || exit 0
    exec setpriv --reuid=65534 --regid=65534 --clear-groups llama-b11056/llama-server -m drafter.gguf \
      --host 127.0.0.1 --port 8099 -c 8192 --parallel 1 -t 4 --no-webui > /dev/null 2>&1
  ) &
fi

# autolab 018: can this LAN carry what expert parallelism would put on it? Every box echoes 100 kB messages with every
# other box, ramped 1 -> 5 -> 15 -> 30 -> 50 MB/s transmitted per box (12.5 minutes), scheduled on rank 0's clock, once per
# boot. A box that sees > 3 % TCP retransmits stops climbing; one whose kernel complains about USB / the NIC stops
# sending. Results: "stage profile" lines relayed by the beacon (autolab/bench/probe_read.py N18). The model is idle.
if [ ! -e /run/cascadia-inkling/nettest018.done ]; then
(
  set +e +u
  sleep 420
  [ -e /run/cascadia-inkling/nettest018.done ] && exit 0
  cat > /run/cascadia-inkling/nettest018.py <<'NETTEST_PY'
#!/usr/bin/env python3
"""All-to-all request/reply traffic between the fleet's boxes, the pattern expert parallelism would put on the LAN.

Runs on every box at once (started from fleet-overrides.env, standard library only). Each box is a server (echoes
every message back) and a client of every other box (sends MSG-byte requests, waits for the MSG-byte reply, paced
so that the box transmits RATE MB/s in total: half as requests, half as the replies it serves). The rate ramps in
steps; rank 0's server is the clock every box schedules the steps on. At the end of each step one line goes to
stdout in the "stage profile" form the beacon relays to rank 0 (integers only): achieved MB/s from the interface
counters, round-trip percentiles of the messages in microseconds, stalls, TCP retransmits, kernel complaints about
the NIC. A box that sees more than 3 % retransmitted segments stops climbing; one whose kernel complains about
USB / the NIC stops sending.

Test hooks (environment): NETTEST_SELF, NETTEST_PEERS=host:port,..., NETTEST_PORT, NETTEST_SCALE (divide all times).
"""
import os, re, socket, struct, subprocess, sys, threading, time

RANK = int(os.environ.get("NETTEST_SELF", os.environ.get("RANK", "0")))
TOTAL = int(os.environ.get("TOTAL", "11"))
FLEET = os.environ.get("FLEET", "inkling")
PORT = int(os.environ.get("NETTEST_PORT", "9200"))
SCALE = float(os.environ.get("NETTEST_SCALE", "1"))
TAG = os.environ.get("NETTEST_TAG", "N18")
MSG = 100_000
STEPS = [(30, 1), (180, 5), (180, 15), (180, 30), (180, 50)]  # (seconds, MB/s transmitted per box)
HDR = struct.Struct("!cQI")
if os.environ.get("NETTEST_PEERS"):
    PEERS = [(i, h.rsplit(":", 1)[0], int(h.rsplit(":", 1)[1])) for i, h in enumerate(os.environ["NETTEST_PEERS"].split(","))]
else:
    PEERS = [(i, "%s-rank-%d" % (FLEET, i), PORT) for i in range(TOTAL)]
T0 = time.monotonic()
lock = threading.Lock()
rtts, state = [], {"rate": 0.0, "stop": False, "held": 0, "abort": 0, "offset": None, "connected": 0}


def recv_exact(s, n):
    buf = bytearray()
    while len(buf) < n:
        chunk = s.recv(min(1 << 20, n - len(buf)))
        if not chunk:
            raise ConnectionError("closed")
        buf += chunk
    return buf


def serve(conn):
    try:
        conn.setsockopt(socket.IPPROTO_TCP, socket.TCP_NODELAY, 1)
        while True:
            kind, seq, n = HDR.unpack(recv_exact(conn, HDR.size))
            body = recv_exact(conn, n) if n else b""
            if kind == b"T":  # what time is it on this box's test clock (ms)
                conn.sendall(HDR.pack(b"T", int((time.monotonic() - T0) * 1000), 0))
            else:
                conn.sendall(HDR.pack(b"E", seq, len(body)) + body)
    except Exception:  # noqa: BLE001
        pass
    finally:
        conn.close()


def server():
    ls = socket.socket(); ls.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    ls.bind(("0.0.0.0", PORT)); ls.listen(64)
    while True:
        c, _ = ls.accept()
        threading.Thread(target=serve, args=(c,), daemon=True).start()


def dial(host, port, deadline):
    while time.monotonic() < deadline and not state["stop"]:
        try:
            s = socket.create_connection((host, port), timeout=3)
            s.setsockopt(socket.IPPROTO_TCP, socket.TCP_NODELAY, 1); s.settimeout(10)
            return s
        except OSError:
            time.sleep(2)
    return None


def client(host, port):
    s = dial(host, port, T0 + 1500 / SCALE)
    if s is None:
        return
    with lock:
        state["connected"] += 1
    payload, seq = b"\xa5" * MSG, 0
    while not state["stop"]:
        rate = state["rate"]
        if rate <= 0 or state["abort"]:
            time.sleep(0.05); continue
        gap = MSG / (rate * 1e6 / 2 / max(1, len(PEERS) - 1))  # seconds between this peer's requests
        t = time.monotonic()
        try:
            s.sendall(HDR.pack(b"E", seq, MSG) + payload)
            recv_exact(s, HDR.size + MSG)
        except Exception:  # noqa: BLE001
            with lock:
                rtts.append(10.0)  # a lost connection counts as a 10 s stall
            s.close(); s = dial(host, port, T0 + 1500 / SCALE)
            if s is None:
                return
            continue
        dt = time.monotonic() - t; seq += 1
        with lock:
            rtts.append(dt)
        time.sleep(max(0.0, gap - dt))


def counters():
    iface = subprocess.run("ip -o -4 route show to default | awk '{print $5; exit}'", shell=True, capture_output=True, text=True).stdout.strip()
    rd = lambda p: int(open(p).read()) if os.path.exists(p) else 0
    tx, rx = rd("/sys/class/net/%s/statistics/tx_bytes" % iface), rd("/sys/class/net/%s/statistics/rx_bytes" % iface)
    snmp = open("/proc/net/snmp").read() if os.path.exists("/proc/net/snmp") else ""
    m = re.search(r"Tcp: (\D[^\n]*)\nTcp: ([^\n]*)", snmp)
    tcp = dict(zip(m.group(1).split(), map(int, m.group(2).split()))) if m else {}
    return tx, rx, tcp.get("OutSegs", 0), tcp.get("RetransSegs", 0)


def kernel_complaints(seconds):
    try:
        out = subprocess.run(["journalctl", "-k", "-q", "--no-pager", "--since", "-%ds" % seconds], capture_output=True, text=True, timeout=8).stdout
    except Exception:  # noqa: BLE001
        return 0
    return len(re.findall(r"xhci|cdc_ncm|NETDEV WATCHDOG|transmit queue|usb [\d.-]+: reset|link is not ready", out, re.I))


def main():
    threading.Thread(target=server, daemon=True).start()
    ref = [p for p in PEERS if p[0] == 0][0]
    if RANK == 0:
        state["offset"] = 0.0
    else:  # schedule on rank 0's clock
        s = dial(ref[1], ref[2], T0 + 1200 / SCALE)
        if s is None:
            print("%sX probe stage profile ph=9 noref=1" % TAG, flush=True); return
        s.sendall(HDR.pack(b"T", 0, 0)); _, ms, _ = HDR.unpack(recv_exact(s, HDR.size)); s.close()
        state["offset"] = ms / 1000.0 - (time.monotonic() - T0)
    for i, h, p in PEERS:
        if i != RANK:
            threading.Thread(target=client, args=(h, p), daemon=True).start()
    t_end, prev_rate = 0.0, 0.0
    for ph, (dur, rate) in enumerate(STEPS):
        t_start, t_end = t_end, t_end + dur / SCALE
        now = time.monotonic() - T0 + state["offset"]
        if now >= t_end:
            continue  # joined late: this step is over on rank 0's clock
        time.sleep(max(0.0, t_start - now))
        state["rate"] = prev_rate if state["held"] else float(rate)
        with lock:
            rtts.clear()
        c0, w0, kerr, t_ph = counters(), counters(), 0, time.monotonic()
        while time.monotonic() - T0 + state["offset"] < t_end:
            time.sleep(min(15.0 / SCALE, max(0.05, t_end - (time.monotonic() - T0 + state["offset"]))))
            w1 = counters()
            if w1[2] - w0[2] > 2000 and (w1[3] - w0[3]) > 0.03 * (w1[2] - w0[2]) and not state["held"]:
                state["held"] = 1; state["rate"] = prev_rate or 1.0  # the LAN is dropping: climb no further
            w0 = w1
            k = kernel_complaints(max(2, int(15 / SCALE)))
            kerr += k
            if k and not state["abort"]:
                state["abort"] = 1
        c1, secs = counters(), max(1e-3, time.monotonic() - t_ph)
        with lock:
            r = sorted(rtts)
        q = lambda f: int(r[min(len(r) - 1, int(f * len(r)))] * 1e6) if r else 0
        line = ("%sP%d probe stage profile ph=%d rate=%d tx_kbs=%d rx_kbs=%d msgs=%d rtt_p50_us=%d rtt_p99_us=%d rtt_max_us=%d "
                "stalls50=%d stalls200=%d retrans=%d segs=%d peers=%d held=%d abort=%d kerr=%d" % (
                    TAG, ph, ph, int(state["rate"]), (c1[0] - c0[0]) / secs / 1e3, (c1[1] - c0[1]) / secs / 1e3, len(r), q(0.5), q(0.99),
                    int(r[-1] * 1e6) if r else 0, sum(x > 0.05 for x in r), sum(x > 0.2 for x in r), c1[3] - c0[3], c1[2] - c0[2],
                    state["connected"], state["held"], state["abort"], kerr))
        for _ in range(3):
            print(line, flush=True); time.sleep(2 / SCALE)
        if not state["held"]:
            prev_rate = float(rate)
    state["rate"] = 0.0
    time.sleep(60 / SCALE)  # keep echoing for boxes that started later
    state["stop"] = True


if __name__ == "__main__":
    main()
NETTEST_PY
  /usr/bin/python3 /run/cascadia-inkling/nettest018.py
  : > /run/cascadia-inkling/nettest018.done
) &
fi
